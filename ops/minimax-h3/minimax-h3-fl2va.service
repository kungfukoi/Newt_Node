[Unit]
Description=MiniMax H3 FL2VA local SGLang service for Newt Node
Wants=network-online.target
After=network-online.target
Conflicts=minimax-h3-ref2va.service

[Service]
Type=simple
User=minimax
Group=minimax
WorkingDirectory=/opt/minimax-h3
Environment=HOME=/home/minimax
Environment=HF_HOME=/opt/minimax-h3/hf-cache
Environment=CUDA_HOME=/opt/minimax-h3/venv/lib/python3.12/site-packages/nvidia/cu13
Environment=CUDA_PATH=/opt/minimax-h3/venv/lib/python3.12/site-packages/nvidia/cu13
Environment=PATH=/opt/minimax-h3/venv/bin:/opt/minimax-h3/venv/lib/python3.12/site-packages/nvidia/cu13/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=PYTHONUNBUFFERED=1
Environment=PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
ExecStart=/opt/minimax-h3/venv/bin/sglang serve --model-path /opt/minimax-h3/model --model-type diffusion --backend sglang --pipeline-class-name MiniMaxH3Pipeline --model-variant fl2va --served-model-name MiniMaxAI/MiniMax-H3 --component-weights-paths.transformer /opt/minimax-h3/weights/minimax_h3_fl2va_bf16.safetensors --component-weights-paths.text_encoder /opt/minimax-h3/weights/qwen3vl_32b_minimax_h3_int8_convrot.safetensors --quantization kitchen_int8 --attention-backend fa --performance-mode memory --layerwise-offload-components dit,text_encoder --dit-offload-prefetch-size 1 --dit-layerwise-resident-layers 0 --vae-cpu-offload true --enable-torch-compile false --host 127.0.0.1 --port 30010
Restart=on-failure
RestartSec=15
TimeoutStartSec=infinity
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
