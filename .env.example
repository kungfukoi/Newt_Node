# Provider values below are managed by the Settings UI.
# Saving Settings writes the active key for each service into .env.
# Disabled keys remain saved as commented lines so they can be re-enabled.
# Do not commit your real .env file.

FAL_KEY=
GOOGLE_API_KEY=
KREA_API_KEY=
OPENAI_API_KEY=

