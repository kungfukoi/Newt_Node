# Provider values below are managed by the Settings UI.
# Saving Settings writes the active key for each service into .env.
# Disabled keys remain saved as commented lines so they can be re-enabled.
# Do not commit your real .env file.

FAL_KEY=
GOOGLE_API_KEY=
KREA_API_KEY=
OPENAI_API_KEY=

# Optional runtime overrides.
# PORT=3336
# VITE_API_PORT=3336
# NEWTNODE_CONTROL_PORT=3337
# VITE_CONTROL_API_PORT=3337
# VITE_CLIENT_PORT=5176
# NEWTNODE_UPDATE_REPOSITORY=https://github.com/kungfukoi/Newt_Node.git

# Optional local media tool overrides. Bundled static binaries are the default.
# FFMPEG_PATH=
# FFPROBE_PATH=

# Optional ComfyUI integration overrides.
# COMFYUI_ROOT=
# WANWARP_COMFY_URL=http://127.0.0.1:8188
# WANBLEND_COMFY_URL=http://127.0.0.1:8188
# WANWARP_COMFY_TIMEOUT_MS=1800000
# WANBLEND_COMFY_TIMEOUT_MS=1800000
# WANWARP_DEPTH_VIDEO_PATH=

# Optional Local MiniMax H3 SGLang service overrides.
# MINIMAX_H3_LOCAL_URL=http://127.0.0.1:30010
# MINIMAX_H3_LOCAL_REF_URL=http://127.0.0.1:30011
# MINIMAX_H3_LOCAL_MODEL=MiniMaxAI/MiniMax-H3
# MINIMAX_H3_LOCAL_TIMEOUT_MS=21600000
# MINIMAX_H3_LOCAL_POLL_INTERVAL_MS=1000
# MINIMAX_H3_LOCAL_HOST_MEDIA_ROOT=
# MINIMAX_H3_LOCAL_ENGINE_MEDIA_ROOT=

# Optional local concurrency tuning.
# NEWTNODE_IMAGE_GENERATION_CONCURRENCY=3
# NEWTNODE_MEDIA_PERSISTENCE_CONCURRENCY=2

# Optional smoke-test targets for non-default ports.
# NEWT_SMOKE_CLIENT_URL=http://127.0.0.1:5176/
# NEWT_SMOKE_API_URL=http://127.0.0.1:3336/api/health

# Optional model endpoint/pricing overrides.
# TEXT_LLM_PROVIDER=fal
# FAL_TEXT_MODEL=openai/gpt-5.6-terra
# FAL_VISION_TEXT_MODEL=openai/gpt-5.6-terra
# FAL_VISION_TEXT_FALLBACK_MODEL=openai/gpt-5.6-terra
# FAL_VIDEO_TEXT_MODEL=google/gemini-3.1-pro-preview
# STORYBOARD_TEXT_MODEL=openai/gpt-5.6-terra
# STORYBOARD_VISION_TEXT_MODEL=openai/gpt-5.6-terra
# FAL_NANO_BANANA_2_ENDPOINT=fal-ai/nano-banana-2
# FAL_NANO_BANANA_2_EDIT_ENDPOINT=fal-ai/nano-banana-2/edit
# FAL_Z_IMAGE_ENDPOINT=fal-ai/z-image/turbo
# Z_IMAGE_COST_PER_MEGAPIXEL=0.005
# FAL_SEEDREAM_5_PRO_TEXT_ENDPOINT=bytedance/seedream/v5/pro/text-to-image
# FAL_SEEDREAM_5_PRO_EDIT_ENDPOINT=bytedance/seedream/v5/pro/edit
# SEEDREAM_5_PRO_COST_SMALL=0.0675
# SEEDREAM_5_PRO_COST_2K=0.135
# FAL_SEEDREAM_LAYER_ENDPOINT=fal-ai/qwen-image-layered
# SEEDREAM_LAYER_SEPARATION_COST=0.05
# SEEDANCE_4K_COST_PER_1000_TOKENS=0.008
# FAL_KLING_O3_PRO_TEXT_ENDPOINT=fal-ai/kling-video/o3/pro/text-to-video
# FAL_KLING_O3_PRO_REFERENCE_ENDPOINT=fal-ai/kling-video/o3/pro/reference-to-video
# KLING_O3_PRO_COST_PER_SECOND=0.112
# KLING_O3_PRO_AUDIO_COST_PER_SECOND=0.14
# FAL_KLING_O3_4K_TEXT_ENDPOINT=fal-ai/kling-video/o3/4k/text-to-video
# FAL_KLING_O3_4K_IMAGE_ENDPOINT=fal-ai/kling-video/o3/4k/image-to-video
# FAL_KLING_O3_4K_REFERENCE_ENDPOINT=fal-ai/kling-video/o3/4k/reference-to-video
# KLING_O3_4K_COST_PER_SECOND=0.42
# GOOGLE_GEMINI_OMNI_MODEL=gemini-omni-flash-preview
# FAL_GEMINI_OMNI_TEXT_ENDPOINT=google/gemini-omni-flash
# FAL_GEMINI_OMNI_REFERENCE_ENDPOINT=google/gemini-omni-flash/reference-to-video
# GEMINI_OMNI_GOOGLE_COST_PER_SECOND=0.10
# GEMINI_OMNI_FAL_COST_PER_SECOND=0.13
# FILM_DIRECTOR_FAL_MODEL=openai/gpt-5.6-sol
# FILM_DIRECTOR_VISION_FAL_MODEL=openai/gpt-5.6-sol
# STORYBOARD_QC_FAL_MODEL=openai/gpt-5.6-terra
